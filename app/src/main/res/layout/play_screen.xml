<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/table_background">

    <Button
        android:id="@+id/standButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="196dp"
        android:layout_marginEnd="36dp"
        android:text="Stand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dealerHand" />

    <ImageView
        android:id="@+id/topOfDeck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="116dp"
        app:layout_constraintEnd_toStartOf="@+id/standButton"
        app:layout_constraintStart_toEndOf="@+id/hitButton"
        app:layout_constraintTop_toBottomOf="@+id/dealerScore"
        app:srcCompat="@drawable/back_of_card" />

    <ImageView
        android:id="@+id/middleOfDeck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        app:layout_constraintEnd_toStartOf="@+id/standButton"
        app:layout_constraintStart_toEndOf="@+id/hitButton"
        app:layout_constraintTop_toBottomOf="@+id/dealerScore"
        app:srcCompat="@drawable/back_of_card" />

    <ImageView
        android:id="@+id/bottomOfDeck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        app:layout_constraintEnd_toStartOf="@+id/standButton"
        app:layout_constraintStart_toEndOf="@+id/hitButton"
        app:layout_constraintTop_toBottomOf="@+id/dealerScore"
        app:srcCompat="@drawable/back_of_card" />

    <Button
        android:id="@+id/hitButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="196dp"
        android:text="Hit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dealerHand" />

    <LinearLayout
        android:id="@+id/playerHand"
        android:layout_width="410dp"
        android:layout_height="139dp"
        android:layout_marginBottom="16dp"
        android:isScrollContainer="true"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/dealerHand"
        android:layout_width="412dp"
        android:layout_height="138dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"></LinearLayout>

    <TextView
        android:id="@+id/playerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="157dp"
        android:layout_marginEnd="158dp"
        android:fontFamily="@font/rowdies_regular"
        android:text="Score: 0"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/playerHand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/dealerScore"
        android:layout_width="98dp"
        android:layout_height="46dp"
        android:layout_marginStart="156dp"
        android:layout_marginEnd="157dp"
        android:fontFamily="@font/rowdies_regular"
        android:text="Score: 0"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dealerHand" />

</androidx.constraintlayout.widget.ConstraintLayout>
