<!-- view_flipper_card.xml -->
<android.widget.ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewFlipperCard"
    android:layout_width="200dp"
    android:layout_height="300dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp">

    <!-- Front ImageView (Card Front) -->
    <ImageView
        android:id="@+id/frontCardImage"
        android:layout_width="200dp"
        android:layout_height="300dp"
        android:src="@drawable/clubs1" />

    <!-- Back ImageView (Card Back) -->
    <ImageView
        android:id="@+id/backCardImage"
        android:layout_width="200dp"
        android:layout_height="300dp"
        android:src="@drawable/back_of_card" />
</android.widget.ViewFlipper>
